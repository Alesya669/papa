4. java/com/example/pr1_calculator/MainActivity.kt

(Логика работы калькулятора)

```kotlin
package com.example.pr1_calculator

import android.os.Bundle
import android.widget.Button
import android.widget.EditText
import android.widget.TextView
import androidx.appcompat.app.AppCompatActivity

class MainActivity : AppCompatActivity() {

    private lateinit var curNum: EditText
    private lateinit var textViewNum: TextView
    private lateinit var textViewSign: TextView

    // Переменные для хранения первого числа и знака операции
    private var firstNumber: Double = 0.0
    private var currentOperation: String = ""

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        curNum = findViewById(R.id.EditTextCur)
        textViewNum = findViewById(R.id.textViewNum)
        textViewSign = findViewById(R.id.textViewSign)

        // ===== Обработка цифр (0-9) =====
        val digitButtons = listOf(
            R.id.button0, R.id.button1, R.id.button2, R.id.button3,
            R.id.button4, R.id.button5, R.id.button6, R.id.button7,
            R.id.button8, R.id.button9
        )

        for (id in digitButtons) {
            findViewById<Button>(id).setOnClickListener {
                val digit = (it as Button).text.toString()
                curNum.append(digit)
            }
        }

        // ===== Обработка точки =====
        val btnDot: Button = findViewById(R.id.buttonDot)
        btnDot.setOnClickListener {
            if (curNum.text.isEmpty()) {
                curNum.append("0.")
            } else if (!curNum.text.contains(".")) {
                curNum.append(".")
            }
        }

        // ===== Обработка кнопки "C" (Очистка) =====
        val btnC: Button = findViewById(R.id.buttonC)
        btnC.setOnClickListener {
            curNum.text.clear()
            textViewNum.text = ""
            textViewSign.text = ""
            firstNumber = 0.0
            currentOperation = ""
        }

        // ===== Обработка кнопок операций (+, -, *, /) =====
        val opButtons = mapOf(
            R.id.buttonPlus to "+",
            R.id.buttonMinus to "-",
            R.id.buttonMult to "*",
            R.id.buttonDiv to "/"
        )

        for ((id, op) in opButtons) {
            findViewById<Button>(id).setOnClickListener {
                if (curNum.text.isNotEmpty()) {
                    firstNumber = curNum.text.toString().toDouble()
                    currentOperation = op
                    textViewNum.text = firstNumber.toString()
                    textViewSign.text = op
                    curNum.text.clear()
                }
            }
        }

        // ===== Обработка кнопки "=" =====
        val btnEquals: Button = findViewById(R.id.buttonEquals)
        btnEquals.setOnClickListener {
            if (curNum.text.isNotEmpty() && currentOperation.isNotEmpty()) {
                val secondNumber = curNum.text.toString().toDouble()
                var result = 0.0

                when (currentOperation) {
                    "+" -> result = firstNumber + secondNumber
                    "-" -> result = firstNumber - secondNumber
                    "*" -> result = firstNumber * secondNumber
                    "/" -> {
                        if (secondNumber == 0.0) {
                            curNum.setText("Ошибка")
                            return@setOnClickListener
                        } else {
                            result = firstNumber / secondNumber
                        }
                    }
                }

                // Выводим результат
                curNum.setText(result.toString())
                textViewNum.text = ""
                textViewSign.text = ""
                currentOperation = ""
            }
        }
    }
}
