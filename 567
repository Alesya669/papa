import numpy as np
from math import prod

# ------------------------------------------------------------------
# Индекс случайной согласованности (из лаб. 3/5)
# ------------------------------------------------------------------
RI = {
    1: 0.0,  2: 0.0,  3: 0.58, 4: 0.90, 5: 1.12,
    6: 1.24, 7: 1.32, 8: 1.41, 9: 1.45, 10: 1.49,
    11: 1.51, 12: 1.48, 13: 1.56, 14: 1.57, 15: 1.59,
}


# ------------------------------------------------------------------
# Базовые функции МАИ
# ------------------------------------------------------------------
def ahp_weights(matrix):
    """Веса через среднее геометрическое + проверка согласованности."""
    m = np.array(matrix, dtype=float)
    n = m.shape[0]
    gm = np.array([prod(m[i]) ** (1.0 / n) for i in range(n)])
    weights = gm / gm.sum()

    col_sums = m.sum(axis=0)
    lam = float(np.sum(col_sums * weights))       # λmax
    ci = (lam - n) / (n - 1) if n > 1 else 0.0    # ИС
    cr = ci / RI[n] if RI.get(n, 0) > 0 else 0.0  # ОС
    return weights, lam, ci, cr


def print_matrix(mat, names):
    mat = np.array(mat, dtype=float)
    w = 13
    print(f"{'':>{w}}" + "".join(f"{n:>{w}}" for n in names))
    for i, name in enumerate(names):
        row = f"{name:>{w}}"
        for j in range(len(names)):
            row += f"{mat[i, j]:>{w}.4f}"
        print(row)


def run_ahp(title, criteria, criteria_matrix, alternatives, alt_matrices,
            cr_threshold=0.10):
    """Полный проход МАИ: критерии -> альтернативы -> свёртка."""
    print("\n" + "#" * 78)
    print(f"#  {title}")
    print("#" * 78)

    # --- Шаг 1 ---
    crit_w, lam, ci, cr = ahp_weights(criteria_matrix)
    print("\n--- ШАГ 1. Веса критериев ---")
    print_matrix(criteria_matrix, criteria)
    print("\nВеса критериев:")
    for name, w in zip(criteria, crit_w):
        print(f"  {name:<18}: {w:.4f}   ({w * 100:6.2f}%)")
    print(f"\n  λmax = {lam:.4f}")
    print(f"  ИС   = {ci:.4f}")
    verdict = "СОГЛАСОВАНО" if cr <= cr_threshold else "ТРЕБУЕТ УТОЧНЕНИЯ"
    print(f"  ОС   = {cr:.4f}  ->  {verdict}")

    # --- Шаг 2 ---
    print("\n--- ШАГ 2. Веса альтернатив по каждому критерию ---")
    alt_weights = np.zeros((len(alternatives), len(criteria)))
    for k, crit in enumerate(criteria):
        mat = alt_matrices[k]
        w, lam_k, ci_k, cr_k = ahp_weights(mat)
        alt_weights[:, k] = w
        print(f"\n  Критерий: {crit}")
        print_matrix(mat, alternatives)
        for name, wi in zip(alternatives, w):
            print(f"    {name:<22}: {wi:.4f}")
        verdict_k = "OK" if cr_k <= cr_threshold else "проверить"
        print(f"    λmax={lam_k:.4f},  ИС={ci_k:.4f},  ОС={cr_k:.4f}  ({verdict_k})")

    # --- Шаг 3 ---
    print("\n--- ШАГ 3. Итоговые веса альтернатив ---")
    final = alt_weights @ crit_w

    header = (f"{'Альтернатива':<22}"
              + "".join(f"{c[:10]:>12}" for c in criteria)
              + f"{'ИТОГО':>12}")
    print(header)
    for i, alt in enumerate(alternatives):
        row = f"{alt:<22}"
        for k in range(len(criteria)):
            row += f"{alt_weights[i, k]:>12.4f}"
        row += f"{final[i]:>12.4f}"
        print(row)
    print(f"{'Вес критерия':<22}"
          + "".join(f"{w:>12.4f}" for w in crit_w))

    print("\nРейтинг альтернатив:")
    order = np.argsort(-final)
    for rank, i in enumerate(order, 1):
        print(f"  {rank}. {alternatives[i]:<22} вес = {final[i]:.4f} "
              f"({final[i] * 100:6.2f}%)")
    print(f"\n>>> ЛУЧШИЙ ВАРИАНТ: {alternatives[order[0]]}")
    return final


