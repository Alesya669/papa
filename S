<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Стиль для цифровых кнопок -->
    <style name="CalcButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:textSize">28sp</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:textColor">#000000</item>
    </style>

    <!-- Стиль для кнопок операций -->
    <style name="CalcButtonOp">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:textSize">28sp</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">#FF9800</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- Стиль для кнопки очистки -->
    <style name="CalcButtonClear">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:textSize">28sp</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">#FF5722</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
