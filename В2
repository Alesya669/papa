### 4. `java/com/example/pr1_calculator/MainActivity.kt`
(Обновленная логика с цепочками, обработкой ошибок и автоскрытием)

```kotlin
package com.example.pr1_calculator

import android.os.Bundle
import android.os.Handler
import android.os.Looper
import android.widget.Button
import android.widget.EditText
import android.widget.TextView
import androidx.appcompat.app.AppCompatActivity
import kotlin.math.roundToInt

class MainActivity : AppCompatActivity() {

    // Объявляем переменные для виджетов
    private lateinit var curNum: EditText
    private lateinit var backNum: TextView
    private lateinit var operationText: TextView

    // Переменные для хранения состояния
    private var num1: Double = 0.0
    private var operation: String = ""

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        // Находим виджеты по ID
        curNum = findViewById(R.id.EditTextCur)
        backNum = findViewById(R.id.textViewNum)
        operationText = findViewById(R.id.textViewSign)

        // ===== 1. Обработка цифр (0-9) =====
        val digitButtons = listOf(
            R.id.button0, R.id.button1, R.id.button2, R.id.button3,
            R.id.button4, R.id.button5, R.id.button6, R.id.button7,
            R.id.button8, R.id.button9
        )
        for (id in digitButtons) {
            findViewById<Button>(id).setOnClickListener {
                val digit = (it as Button).text.toString()
                curNum.append(digit)
            }
        }

        // ===== 2. Обработка точки =====
        val btnDot: Button = findViewById(R.id.buttonDot)
        btnDot.setOnClickListener {
            if (curNum.text.isEmpty()) {
                curNum.append("0.")
            } else if (!curNum.text.contains(".")) {
                curNum.append(".")
            }
        }

        // ===== 3. Кнопка "C" (Очистка) =====
        val btnC: Button = findViewById(R.id.buttonC)
        btnC.setOnClickListener {
            curNum.text.clear()
            backNum.text = ""
            operationText.text = ""
            num1 = 0.0
            operation = ""
        }

        // ===== 4. Обработчики операций =====
        findViewById<Button>(R.id.buttonPlus).setOnClickListener { handleOperation("+") }
        findViewById<Button>(R.id.buttonMinus).setOnClickListener { handleOperation("-") }
        findViewById<Button>(R.id.buttonMult).setOnClickListener { handleOperation("*") }
        findViewById<Button>(R.id.buttonDiv).setOnClickListener { handleOperation("/") }

        // ===== 5. Кнопка "=" =====
        val btnEq: Button = findViewById(R.id.buttonEquals)
        btnEq.setOnClickListener {
            try {
                val num2 = curNum.text.toString().toDouble()
                var result = 0.0

                // Проверка деления на ноль
                if (operation == "/" && num2 == 0.0) {
                    showError("Деление на ноль не допускается")
                    return@setOnClickListener
                }

                // Выполнение операции
                when (operation) {
                    "+" -> result = num1 + num2
                    "-" -> result = num1 - num2
                    "*" -> result = num1 * num2
                    "/" -> result = num1 / num2
                }

                // Красивое отображение результата
                if (result % 1.0 == 0.0) {
                    curNum.setText(result.roundToInt().toString())
                } else {
                    curNum.setText(result.toString())
                }

                // Очищаем верхние поля
                backNum.text = ""
                operationText.text = ""

            } catch (e: Exception) {
                // Обработка, если поле пустое
                if (curNum.text.isEmpty()) {
                    showError("Введите число")
                } else if (backNum.text.isEmpty()) {
                    showError("Введите операцию")
                }
            }
        }
    }

    // ===== Функция обработки операций =====
    private fun handleOperation(op: String) {
        // Проверка: поле не должно быть пустым
        if (curNum.text.isEmpty()) {
            showError("Введите число")
            return
        }

        // Сценарий 1: Первая операция
        if (backNum.text.isEmpty() && operationText.text.isEmpty()) {
            operation = op
            operationText.text = operation
            backNum.text = curNum.text
            num1 = backNum.text.toString().toDouble()
            curNum.text.clear()
        }
        // Сценарий 2: Цепочка операций (2 + 3 + ...)
        else if (backNum.text.isNotEmpty() && operationText.text.isNotEmpty() && curNum.text.isNotEmpty()) {
            val num2 = curNum.text.toString().toDouble()
            var result = 0.0

            when (operation) {
                "+" -> result = num1 + num2
                "-" -> result = num1 - num2
                "*" -> result = num1 * num2
                "/" -> {
                    if (num2 == 0.0) {
                        showError("Деление на ноль")
                        return
                    }
                    result = num1 / num2
                }
            }

            // Отображение промежуточного результата
            if (result % 1.0 == 0.0) {
                backNum.text = result.roundToInt().toString()
            } else {
                backNum.text = result.toString()
            }

            num1 = result
            curNum.text.clear()
            operation = op
            operationText.text = operation
        }
        // Сценарий 3: Просто меняем операцию
        else {
            operation = op
            operationText.text = operation
        }
    }

    // ===== Функция показа ошибки с автоскрытием =====
    private fun showError(message: String) {
        curNum.error = message
        curNum.requestFocus()
        Handler(Looper.getMainLooper()).postDelayed({
            curNum.error = null
        }, 1500)
    }
}
