### 1. `res/layout/activity_main.xml`
(Верстка экрана: твои розовые и зеленые кнопки)

```xml
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <!-- Поле ввода текущего числа -->
    <EditText
        android:id="@+id/EditTextCur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:textSize="36sp"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:gravity="end"
        android:hint="0" />

    <!-- Поле для отображения предыдущего числа -->
    <TextView
        android:id="@+id/textViewNum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:padding="8dp"
        android:background="#E0E0E0"
        android:text="" />

    <!-- Поле для отображения операции -->
    <TextView
        android:id="@+id/textViewSign"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:padding="8dp"
        android:background="#E0E0E0"
        android:text="" />

    <!-- Сетка кнопок 4x4 -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="4"
        android:layout_marginTop="16dp">

        <!-- Ряд 1: 7 8 9 / -->
        <Button android:id="@+id/button7" android:text="7" style="@style/CalcButton" android:background="#F8BBD0" />
        <Button android:id="@+id/button8" android:text="8" style="@style/CalcButton" android:background="#F8BBD0" />
        <Button android:id="@+id/button9" android:text="9" style="@style/CalcButton" android:background="#F8BBD0" />
        <Button android:id="@+id/buttonDiv" android:text="/" style="@style/CalcButtonOp" android:background="#C8E6C9" />

        <!-- Ряд 2: 4 5 6 * -->
        <Button android:id="@+id/button4" android:text="4" style="@style/CalcButton" android:background="#F8BBD0" />
        <Button android:id="@+id/button5" android:text="5" style="@style/CalcButton" android:background="#F8BBD0" />
        <Button android:id="@+id/button6" android:text="6" style="@style/CalcButton" android:background="#F8BBD0" />
        <Button android:id="@+id/buttonMult" android:text="*" style="@style/CalcButtonOp" android:background="#C8E6C9" />

        <!-- Ряд 3: 1 2 3 - -->
        <Button android:id="@+id/button1" android:text="1" style="@style/CalcButton" android:background="#F8BBD0" />
        <Button android:id="@+id/button2" android:text="2" style="@style/CalcButton" android:background="#F8BBD0" />
        <Button android:id="@+id/button3" android:text="3" style="@style/CalcButton" android:background="#F8BBD0" />
        <Button android:id="@+id/buttonMinus" android:text="-" style="@style/CalcButtonOp" android:background="#C8E6C9" />

        <!-- Ряд 4: C 0 . + -->
        <Button android:id="@+id/buttonC" android:text="C" style="@style/CalcButtonClear" android:background="#F06292" />
        <Button android:id="@+id/button0" android:text="0" style="@style/CalcButton" android:background="#F8BBD0" />
        <Button android:id="@+id/buttonDot" android:text="." style="@style/CalcButton" android:background="#F8BBD0" />
        <Button android:id="@+id/buttonPlus" android:text="+" style="@style/CalcButtonOp" android:background="#C8E6C9" />

    </GridLayout>

    <!-- Кнопка "=" -->
    <Button
        android:id="@+id/buttonEquals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="="
        android:textSize="32sp"
        android:background="#81C784"
        android:textColor="#FFFFFF"
        android:layout_marginTop="16dp" />

</LinearLayout>
